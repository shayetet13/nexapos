# Local-first defaults. Copy this file to apps/api/.env.local; never commit real secrets.
# The NexaPos backend is the only intended client of this API (it calls /v1/promptpay/*
# and /v1/bots with a per-shop lbk_ key). Keep it on loopback unless you deliberately
# expose it, and set REQUIRE_AUTH=true before it is reachable from anywhere else:
# with REQUIRE_AUTH=false every /v1 route (bots, API keys, credentials) is unauthenticated.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
DASHBOARD_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8787

# Single-admin login. Change both values before using a real LINE account.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me-before-production
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
REQUIRE_AUTH=false

# All state (bots, rules, targets, senders, API keys, queue tickets, and
# fleet-wide settings) lives in this one SQLite file -- there is no separate
# database service to configure. Defaults to ./data/linebot.sqlite3 if unset.
DATABASE_PATH=./data/linebot.sqlite3
# Where each LINEJS bot's encrypted session state (E2EE keys, refresh token)
# is written. Defaults to ./data/linejs if unset.
LINEJS_STORAGE_DIR=./data/linejs

# Rule webhook actions reference an ID here; raw URLs are never accepted from the UI.
# Example: {"orders":"http://localhost:9999/hooks/orders"}
WEBHOOK_ENDPOINTS_JSON={}
