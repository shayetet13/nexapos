{
  "name": "NexaPos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter=@nexapos/shared build && concurrently -n frontend,backend \"pnpm --filter=@nexapos/frontend dev\" \"pnpm --filter=@nexapos/backend dev\"",
    "dev:frontend": "pnpm --filter=@nexapos/frontend dev",
    "dev:backend": "pnpm --filter=@nexapos/backend dev",
    "dev:linebot": "concurrently -k -n linebot-api,linebot-dash \"pnpm --filter=@linebot/api dev\" \"pnpm --filter=@linebot/dashboard dev\"",
    "dev:linebot:api": "pnpm --filter=@linebot/api dev",
    "dev:all": "pnpm --filter=@nexapos/shared build && concurrently -n frontend,backend,linebot \"pnpm --filter=@nexapos/frontend dev\" \"pnpm --filter=@nexapos/backend dev\" \"pnpm --filter=@linebot/api dev\"",
    "test:linebot": "pnpm --filter=@linebot/api --filter=@linebot/contracts --filter=@linebot/rule-engine --filter=@linebot/bot-worker --filter=@linebot/supervisor run test:run",
    "typecheck:linebot": "pnpm --filter=\"@linebot/*\" run typecheck",
    "dev:worker": "pnpm --filter=@nexapos/worker dev",
    "build": "pnpm -r run build",
    "deploy:worker": "pnpm --filter=@nexapos/worker run deploy",
    "build:backend": "pnpm --filter=@nexapos/shared build && pnpm --filter=@nexapos/backend build",
    "start:backend": "node apps/backend/dist/index.js",
    "build:frontend": "pnpm --filter=@nexapos/shared build && pnpm --filter=@nexapos/frontend build",
    "start:frontend": "cd apps/frontend && pnpm start",
    "db:generate": "pnpm --filter=@nexapos/backend db:generate",
    "db:migrate": "pnpm --filter=@nexapos/backend db:migrate",
    "db:push": "pnpm --filter=@nexapos/backend db:push"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@line/liff": "^2.28.0"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.30.1": "7.30.2"
    }
  }
}
